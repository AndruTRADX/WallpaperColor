[led]
mode = "arc"

[extract]
palette_size = 10
sample_size = 96
min_saturation = 0.7
min_chroma = 0.06
min_share = 0.005
skin_weight = 0.15
pastel_gain = 2.5

[openrgb]
address = "192.168.1.5:6742"
client_name = "WallpaperColor"

[[calibration]]
device = "COMMANDER Core"
zone = "Fan"
gain = [
    0.72,
    0.78,
    1.0,
]

[[calibration]]
device = "VENGEANCE"
gain = [
    1.0,
    0.9,
    0.9,
]
