# Unlike the upstream package, an upgrade does not leave the service disabled:
# it is stopped before the files change and started again afterwards if it was enabled.

post_install() {
  udevadm control --reload-rules
  systemctl daemon-reload
  echo "OpenLinkHub installed. Start it with: sudo systemctl enable --now openlinkhub"
  echo "WebUI: http://127.0.0.1:27003"
}

pre_upgrade() {
  systemctl stop openlinkhub.service 2>/dev/null || true
}

post_upgrade() {
  udevadm control --reload-rules
  systemctl daemon-reload
  if systemctl -q is-enabled openlinkhub.service 2>/dev/null; then
    systemctl start openlinkhub.service
  fi
}

pre_remove() {
  systemctl disable --now openlinkhub.service 2>/dev/null || true
}

post_remove() {
  udevadm control --reload-rules
  systemctl daemon-reload
}
