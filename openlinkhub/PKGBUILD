# OpenLinkHub with the local "wallpaper" RGB profile used by WallpaperColor.
# Based on the AUR openlinkhub PKGBUILD (maintainer: jrdn). Replaces the openlinkhub package.
#
# Build and install:  makepkg -si
# When upstream releases a new version: bump _tag/pkgver, check the patch still applies, rebuild.

pkgname=openlinkhub-wallpaper
_name=openlinkhub
_upstreamname=OpenLinkHub
_binlocation=/usr/bin/${_name}
_applocation=/var/lib/${_name}
_tag=0.9.4
pkgver=0.9.4
pkgrel=1
pkgdesc="OpenLinkHub (Corsair iCUE LINK/AIO/hub control) plus a 'wallpaper' RGB profile driven by POST /api/color/wallpaper"
arch=('x86_64')
url="https://github.com/jurkovic-nikola/OpenLinkHub"
license=('GPL-3.0-only')
depends=('systemd' 'i2c-tools' 'libpipewire')
makedepends=('go>=1.26.0' 'git')
provides=("${_name}=${pkgver}")
conflicts=("${_name}")
backup=("etc/udev/rules.d/99-${_name}.rules")
install=${_name}.install
source=(
  "${_name}::git+https://github.com/jurkovic-nikola/${_upstreamname}.git#tag=${_tag}"
  "0001-wallpaper-profile.patch"
  "${_name}.install"
  "${_name}.sysusers"
  "${_name}.service"
  "${_name}.tmpfiles"
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  cd "${_name}"
  git apply "${srcdir}/0001-wallpaper-profile.patch"
}

build() {
  cd "${_name}"
  export CGO_CFLAGS_ALLOW='-fno-strict-overflow'
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -o "${_upstreamname}" .
}

package() {
  install -Dm644 "${_name}.service" "${pkgdir}/usr/lib/systemd/system/${_name}.service"
  install -Dm644 "${_name}.sysusers" "${pkgdir}/usr/lib/sysusers.d/${_name}.conf"
  install -Dm644 "${_name}.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/${_name}.conf"

  install -dm755 "${pkgdir}${_applocation}/"{database,static,web,api}
  cp -r "${_name}"/database/* "${pkgdir}${_applocation}/database/"
  cp -r "${_name}"/static/* "${pkgdir}${_applocation}/static/"
  cp -r "${_name}"/web/* "${pkgdir}${_applocation}/web/"
  cp -r "${_name}"/api/* "${pkgdir}${_applocation}/api/"

  install -Dm644 "${_name}/99-${_name}.rules" "${pkgdir}/etc/udev/rules.d/99-${_name}.rules"
  install -Dm755 "${_name}/${_upstreamname}" "${pkgdir}${_binlocation}"
}
