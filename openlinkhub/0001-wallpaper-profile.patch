--- /dev/null
+++ b/src/rgb/wallpaper.go
@@ -0,0 +1,83 @@
+package rgb
+
+// Wallpaper profile (local patch for WallpaperColor).
+//
+// One colour shared by every device, set from outside through POST /api/color/wallpaper.
+// Channels on the "wallpaper" profile paint it as a static colour. The device animation loops
+// look it up on every frame, so a new colour shows up on the next frame without restarting
+// any effect (no blink). The colour is kept in its own mutex-guarded variable instead of the
+// per-device profile maps, which the animation goroutines read without locking.
+
+import (
+	"encoding/json"
+	"os"
+	"sync"
+)
+
+var (
+	wallpaperMutex sync.RWMutex
+	wallpaperColor = Color{Red: 255, Green: 255, Blue: 255, Brightness: 1}
+	wallpaperFile  string
+)
+
+// initWallpaper loads the last colour saved in database/wallpaper.json, if any
+func initWallpaper(pwd string) {
+	wallpaperFile = pwd + "/database/wallpaper.json"
+	data, err := os.ReadFile(wallpaperFile)
+	if err != nil {
+		return
+	}
+	var c Color
+	if json.Unmarshal(data, &c) == nil {
+		wallpaperColor = clampColor(c)
+	}
+}
+
+func clampColor(c Color) Color {
+	clamp := func(v float64) float64 {
+		if v < 0 {
+			return 0
+		}
+		if v > 255 {
+			return 255
+		}
+		return v
+	}
+	return Color{Red: clamp(c.Red), Green: clamp(c.Green), Blue: clamp(c.Blue), Brightness: 1}
+}
+
+// SetWallpaperColor sets the colour of the wallpaper profile and saves it for the next start
+func SetWallpaperColor(c Color) error {
+	c = clampColor(c)
+	wallpaperMutex.Lock()
+	wallpaperColor = c
+	wallpaperMutex.Unlock()
+
+	if wallpaperFile == "" {
+		return nil
+	}
+	data, err := json.Marshal(c)
+	if err != nil {
+		return err
+	}
+	tmp := wallpaperFile + ".tmp"
+	if err = os.WriteFile(tmp, data, 0644); err != nil {
+		return err
+	}
+	return os.Rename(tmp, wallpaperFile)
+}
+
+// GetWallpaperColor returns the current colour of the wallpaper profile
+func GetWallpaperColor() Color {
+	wallpaperMutex.RLock()
+	defer wallpaperMutex.RUnlock()
+	return wallpaperColor
+}
+
+// Wallpaper paints every LED of the channel with the wallpaper colour at the channel brightness
+func (r *ActiveRGB) Wallpaper() {
+	c := GetWallpaperColor()
+	c.Brightness = r.RGBBrightness
+	r.RGBStartColor = &c
+	r.Static()
+}
diff --git a/src/server/server.go b/src/server/server.go
index 560f6645..71962f4f 100644
--- a/src/server/server.go
+++ b/src/server/server.go
@@ -1293,6 +1293,31 @@ func setAllDevicesColor(w http.ResponseWriter, r *http.Request) {
 	resp.Send(w)
 }
 
+// setWallpaperColor sets the colour of the "wallpaper" RGB profile (local patch for WallpaperColor).
+// Body: {"red":0-255,"green":0-255,"blue":0-255}
+func setWallpaperColor(w http.ResponseWriter, r *http.Request) {
+	var c rgb.Color
+	resp := &Response{Code: http.StatusOK, Status: 0}
+	if err := json.NewDecoder(r.Body).Decode(&c); err != nil {
+		resp.Message = language.GetValue("txtUnableToValidateRequest")
+		resp.Send(w)
+		return
+	}
+	if err := rgb.SetWallpaperColor(c); err != nil {
+		logger.Log(logger.Fields{"error": err}).Warn("Unable to save wallpaper colour")
+	}
+	resp.Status = 1
+	resp.Message = "Wallpaper colour updated"
+	resp.Data = rgb.GetWallpaperColor()
+	resp.Send(w)
+}
+
+// getWallpaperColor returns the colour of the "wallpaper" RGB profile (local patch for WallpaperColor)
+func getWallpaperColor(w http.ResponseWriter, r *http.Request) {
+	resp := &Response{Code: http.StatusOK, Status: 1, Data: rgb.GetWallpaperColor()}
+	resp.Send(w)
+}
+
 // setLinkAdapterColor handles LINK adapter color changes
 func setLinkAdapterColor(w http.ResponseWriter, r *http.Request) {
 	request := requests.ProcessChangeLinkAdapterColor(r)
@@ -2841,6 +2866,8 @@ func setRoutes() http.Handler {
 	handleFunc(r, "/api/color", http.MethodPost, setDeviceColor)
 	handleFunc(r, "/api/color/global", http.MethodPost, setGlobalDeviceColor)
 	handleFunc(r, "/api/color/all", http.MethodPost, setAllDevicesColor)
+	handleFunc(r, "/api/color/wallpaper", http.MethodPost, setWallpaperColor)
+	handleFunc(r, "/api/color/wallpaper/current", http.MethodGet, getWallpaperColor)
 	handleFunc(r, "/api/color/linkAdapter", http.MethodPost, setLinkAdapterColor)
 	handleFunc(r, "/api/color/linkAdapter/bulk", http.MethodPost, setLinkAdapterBulkColor)
 	handleFunc(r, "/api/color/getOverride", http.MethodPost, getRgbOverride)
